ARG MUSL_IMAGE=ghcr.io/rust-cross/rust-musl-cross:x86_64-musl
ARG TARGET_TRIPLE=x86_64-unknown-linux-musl

# Note: Some podman setups require `podman build --arch amd64` when pulling
# this manifest list from GHCR.

FROM ${MUSL_IMAGE} AS builder

ARG TARGET_TRIPLE

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY static ./static
COPY migrations ./migrations

RUN rustup target add ${TARGET_TRIPLE} || true
RUN cargo build --release --target ${TARGET_TRIPLE}
RUN musl-strip target/${TARGET_TRIPLE}/release/schweinehund-backend || true

FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

ARG TARGET_TRIPLE=x86_64-unknown-linux-musl

COPY --from=builder /app/target/${TARGET_TRIPLE}/release/schweinehund-backend ./server

ENV TZ=Europe/Berlin
ENV DATABASE_URL=sqlite:/app/data/schweinehund.sqlite

EXPOSE 8090

CMD ["./server"]
