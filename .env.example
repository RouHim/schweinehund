# Schweinehund Environment Configuration
# Copy this file to .env and customize for your environment

# Rust Backend Configuration
# HTTP server port (default: 8090)
PORT=8090

# SQLite database path (default: sqlite:data/schweinehund.sqlite)
DATABASE_URL=sqlite:data/schweinehund.sqlite

# Backend notification endpoint
# For Docker: http://ntfy:80/schweinehund
# For run.sh: http://127.0.0.1:8091/schweinehund
NTFY_URL=http://127.0.0.1:8091/schweinehund

# ntfy Container Configuration
# Base URL for ntfy push notification service container
# For Docker: http://ntfy:80
# For local development: http://localhost:8091
NTFY_BASE_URL=http://localhost:8091

# Timezone
# Optional: Override default timezone (defaults to Europe/Berlin)
# TZ=Europe/Berlin
