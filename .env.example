# Schweinehund Environment Configuration
# Copy this file to .env and customize for your environment

# PocketBase Configuration
# IMPORTANT: Change this in production! Used for encrypting sensitive data.
PB_ENCRYPTION_KEY=your-encryption-key-here-min-32-characters

# ntfy Configuration
# Base URL for push notification service
# For local development: http://schweinehund.local:8091
# For production: https://your-domain.com/ntfy or your ntfy instance URL
NTFY_BASE_URL=http://schweinehund.local:8091

# Domain Configuration
# Domain name for the application
# For local development: schweinehund.local
# For production: your-domain.com
DOMAIN=schweinehund.local

# Timezone
# Optional: Override default timezone (defaults to Europe/Berlin)
# TZ=Europe/Berlin
