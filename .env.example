# Schweinehund Environment Configuration
# Copy this file to .env and customize for your environment

# PocketBase Configuration
# IMPORTANT: Change this in production! Used for encrypting sensitive data.
PB_ENCRYPTION_KEY=your-encryption-key-here-min-32-characters

# ntfy Configuration
# Base URL for push notification service
# For local development: http://localhost:8091
# For production: https://your-ntfy-instance.com or your ntfy instance URL
NTFY_BASE_URL=http://localhost:8091

# Timezone
# Optional: Override default timezone (defaults to Europe/Berlin)
# TZ=Europe/Berlin
