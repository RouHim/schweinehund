{
  http_port 80
  https_port 443
  auto_https disable_redirects
}

# HTTPS configuration for schweinehund.local
https://schweinehund.local:8080 {
  tls /etc/caddy/certs/schweinehund.local.crt /etc/caddy/certs/schweinehund.local.key

  # Route to PocketBase API
  route /api/* {
    reverse_proxy pocketbase:8090
  }

  # Route to PocketBase Admin Panel
  route /_/* {
    reverse_proxy pocketbase:8090
  }

  # Static frontend files (to be served from volume)
  route / {
    root * /app/frontend
    try_files {path} /index.html
    file_server
  }

  # Reverse proxy fallback
  reverse_proxy pocketbase:8090
}

# HTTP to HTTPS redirect (optional, for local testing)
http://schweinehund.local {
  redir https://schweinehund.local:8080{uri}
}
