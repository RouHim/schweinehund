FROM docker.io/debian:bookworm-slim AS prep

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /data /tmp /etc/ssl/certs /usr/share/zoneinfo \
    && chmod 1777 /tmp \
    && touch /data/.keep \
    && chown -R 1000:1000 /data

FROM scratch

ENV DATA_FOLDER="/data"
ENV RUST_LOG="info"
ENV TZ="UTC"
ENV SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"

VOLUME /data
EXPOSE 9666

WORKDIR /data

COPY --from=prep /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=prep /usr/share/zoneinfo/UTC /usr/share/zoneinfo/UTC
COPY --from=prep /tmp /tmp
COPY --from=prep --chown=1000:1000 /data /data

# CI downloads the musl binary artifact to this path before building
COPY --chown=1000:1000 target/x86_64-unknown-linux-musl/release/schweinehund /schweinehund

USER 1000:1000
ENTRYPOINT ["/schweinehund"]
