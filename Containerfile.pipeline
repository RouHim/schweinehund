FROM docker.io/alpine:3.20 AS prep

RUN apk add --no-cache ca-certificates tzdata

# Prepare a minimal filesystem tree that will be copied into the scratch image.
# This ensures runtime essentials exist even without a shell/base OS.
RUN set -eux; \
    mkdir -p \
      /rootfs/etc/ssl/certs \
      /rootfs/usr/share/zoneinfo/Etc \
      /rootfs/tmp \
      /rootfs/data \
      /rootfs/etc; \
    cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ca-certificates.crt; \
    cp /usr/share/zoneinfo/UTC /rootfs/usr/share/zoneinfo/UTC; \
    if [ -f /usr/share/zoneinfo/Etc/UTC ]; then cp /usr/share/zoneinfo/Etc/UTC /rootfs/usr/share/zoneinfo/Etc/UTC; fi; \
    cp /usr/share/zoneinfo/UTC /rootfs/etc/localtime; \
    chmod 1777 /rootfs/tmp; \
    chown 1000:1000 /rootfs/data

FROM scratch

ENV DATA_FOLDER="/data"
ENV RUST_LOG="info"
ENV SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"
ENV TZ="UTC"

VOLUME /data
WORKDIR /data

COPY --from=prep /rootfs/ /

COPY --chown=1000:1000 target/x86_64-unknown-linux-musl/release/schweinehund /schweinehund

EXPOSE 9666
USER 1000:1000
ENTRYPOINT ["/schweinehund"]
